#include <iostream>
#include <string>
using namespace std;

int main() {
  string food = "Pizza";  
  string* ptr = &food;    // Declared, Initialized, and assigned the address of 'food' to 'ptr'

  cout << food << "\n";    // Outputs: Pizza 
  cout << &food << "\n";   // Outputs: 0x... (Memory Address)
  cout << ptr << "\n";     // Outputs: 0x... (Same Memory Address)

  //Accessing the value via the pointer
  cout << *ptr << "\n";    // Outputs: Pizza
  
  return 0;
}
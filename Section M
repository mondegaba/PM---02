#include <iostream>
#include <fstream>
#include <string>
#include <cstring>

// Forward declarations of helper functions
void conductErrorHandling(const std::ios& stream, const std::string& streamName);
bool compareFiles(const std::string& file1, const std::string& file2);

int main() {
    std::string filename1 = "file1.bin";
    std::string filename2 = "file2.bin";

    // -------------------------------------------------------------------------
    // PA1301: Open files & PA1303: Write to files
    // -------------------------------------------------------------------------
    std::ofstream outFile1(filename1, std::ios::binary);
    
    // PA1312: Conduct error handling with IO stream
    if (!outFile1) {
        std::cerr << " Error opening " << filename1 << " for writing.\n";
        return 1;
    }

    // PA1310: Write raw bytes to file
    const char* rawData = "AB\nCDE";
    outFile1.write(rawData, std::strlen(rawData));
    
    // PA1302: Close files
    outFile1.close(); 

    std::cout << "[Success] PA1301, PA1302, PA1303, PA1310 completed.\n\n";

    // -------------------------------------------------------------------------
    // PA1307: Load characters from cin stream directly to file
    // -------------------------------------------------------------------------
    std::cout << "PA1307: Enter a brief line of text to save to " << filename2 << ":\n> ";
    std::string userInput;
    std::getline(std::cin, userInput); // Taking from cin stream

    std::ofstream outFile2(filename2, std::ios::binary);
    if (outFile2) {
        outFile2 << userInput; // Loading directly to file
        outFile2.close();
    }

    // -------------------------------------------------------------------------
    // PA1304: Read from files & PA1305: Extract characters
    // PA1308: Peek, PA1309: Putback/Unget, PA1311: Count characters
    // -------------------------------------------------------------------------
    std::ifstream inFile1(filename1, std::ios::binary);
    if (!inFile1) {
        std::cerr << "PA1312: Error opening " << filename1 << " for reading.\n";
        return 1;
    }

    std::cout << "\n--- Demonstrating Advanced Stream Manipulation on " << filename1 << " ---\n";

    // PA1308: Peek characters without extracting
    char peekedChar = inFile1.peek();
    std::cout << "PA1308: Peeked at next character: '" << peekedChar << "' (Stream pointer did not move)\n";

    // PA1305: Extract character
    char extractedChar = inFile1.get();
    std::cout << "PA1305: Extracted character: '" << extractedChar << "'\n";

    // PA1309: Return extracted character back to the stream
    inFile1.putback(extractedChar); 
    std::cout << "PA1309: Put back '" << extractedChar << "' onto the stream.\n";

    // PA1304 / PA1310: Read bytes block into a buffer
    char buffer[10];
    inFile1.read(buffer, 4); // Attempt to read 4 bytes

    // PA1311: Count characters from the last operation
    std::streamsize bytesRead = inFile1.gcount();
    std::cout << "PA1311: Number of characters successfully read in last operation: " << bytesRead << "\n";
    
    // PA1312: Error check after read
    conductErrorHandling(inFile1, filename1);
    inFile1.close();

    // -------------------------------------------------------------------------
    // PA1306: Compare content of two files
    // -------------------------------------------------------------------------
    std::cout << "\n--- PA1306: Comparing Content of Two Files ---\n";
    bool areIdentical = compareFiles(filename1, filename2);
    if (areIdentical) {
        std::cout << "Result: " << filename1 << " and " << filename2 << " are completely identical.\n";
    } else {
        std::cout << "Result: " << filename1 << " and " << filename2 << " have different contents.\n";
    }

    return 0;
}

// -------------------------------------------------------------------------
// PA1312: Comprehensive Error Handling Implementation
// -------------------------------------------------------------------------
void conductErrorHandling(const std::ios& stream, const std::string& streamName) {
    std::cout << "PA1312: Checking health state for [" << streamName << "]:\n";
    if (stream.good()) {
        std::cout << "  - Stream state is GOOD.\n";
    }
    if (stream.eof()) {
        std::cout << "  - Note: End of File (EOF) reached.\n";
    }
    if (stream.fail()) {
        std::cout << "  - Warning: Logical error/Format mismatch (FAIL bit set).\n";
    }
    if (stream.bad()) {
        std::cout << "  - Critical: Serious I/O error occurred (BAD bit set).\n";
    }
}

// -------------------------------------------------------------------------
// PA1306: Compare logic using byte extraction
// -------------------------------------------------------------------------
bool compareFiles(const std::string& file1, const std::string& file2) {
    std::ifstream f1(file1, std::ios::binary | std::ios::ate); // Open at end to check size
    std::ifstream f2(file2, std::ios::binary | std::ios::ate);

    if (!f1 || !f2) {
        return false; // Can't open one of the files
    }

    // Check sizes first
    if (f1.tellg() != f2.tellg()) {
        return false; 
    }

    // Seek back to beginning for content check
    f1.seekg(0, std::ios::beg);
    f2.seekg(0, std::ios::beg);

    char ch1, ch2;
    // PA1305: Extract characters sequentially to compare
    while (f1.get(ch1) && f2.get(ch2)) {
        if (ch1 != ch2) {
            return false; // Content mismatch
        }
    }
    return true;
}